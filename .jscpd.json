{
  "minTokens": 60,
  "minLines": 6,
  "mode": "mild",
  "threshold": 2,
  "format": [
    "typescript",
    "tsx"
  ],
  "pattern": "**/*.{ts,tsx}",
  "ignore": [
    "**/tests/**",
    "**/tsdown.config.ts",
    "**/lib/**"
  ],
  "ignorePattern": [
    "(?s)/\\* jscpd:ignore-start \\*/.*?/\\* jscpd:ignore-end \\*/"
  ],
  "reporters": [
    "console"
  ],
  "noColors": true,
  "noTips": true
}
