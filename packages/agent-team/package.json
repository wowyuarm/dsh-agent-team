{
  "name": "@deepseek-ai/dsh-agent-team",
  "description": "Durable single-host Agent Team operation ledger and collaboration runtime",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/dsh-agent-team.git",
    "directory": "packages/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0",
    "@deepseek-ai/dsh-brand": "^0.1.0",
    "@deepseek-ai/dsh-home-paths": "^0.1.0",
    "@deepseek-ai/dsh-invariants": "^0.1.0",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0",
    "@deepseek-ai/dsh-scope": "^0.1.0",
    "@deepseek-ai/dsh-session": "^0.1.0",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0",
    "@deepseek-ai/dsh-tools": "^0.1.0",
    "@deepseek-ai/dsh-workspace": "^0.1.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
